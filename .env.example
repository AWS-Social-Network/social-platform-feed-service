AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Main feed queue URL (same queue Lambda publishes to). Configure redrive policy + DLQ with maxReceiveCount in AWS.
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/feed-events
# LocalStack SQS API endpoint (same host as DynamoDB edge, port 4566)
# SQS_ENDPOINT_URL=http://127.0.0.1:4566

REDIS_URL=redis://localhost:6379/0

# Optional tuning
# SQS_MAX_MESSAGES=10
# SQS_WAIT_TIME_SECONDS=20
# SQS_VISIBILITY_TIMEOUT=60
# FEED_MAX_LENGTH=500
# DEDUP_TTL_SECONDS=86400

SECRET_KEY=change-me-use-long-random-string-shared-with-post-and-feed
ALGORITHM=HS256
